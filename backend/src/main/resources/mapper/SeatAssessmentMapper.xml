<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.seat.mapper.SeatAssessmentMapper">

    <sql id="baseFrom">
        FROM seat_assessment a
        LEFT JOIN sys_user u ON u.id = a.user_id
        LEFT JOIN study_room r ON r.id = a.room_id
        LEFT JOIN long_term_seat lt ON lt.id = a.actual_seat_id
        LEFT JOIN seat s ON s.id = lt.seat_id
    </sql>

    <sql id="whereSql">
        <where>
            <if test="query.userId != null">
                AND a.user_id = #{query.userId}
            </if>
            <if test="query.assessMonth != null and query.assessMonth != ''">
                AND a.assess_month = #{query.assessMonth}
            </if>
            <if test="query.qualified != null">
                AND a.qualified = #{query.qualified}
            </if>
            <if test="query.roomId != null">
                AND a.room_id = #{query.roomId}
            </if>
            <if test="query.keyword != null and query.keyword != ''">
                AND (u.real_name LIKE CONCAT('%', #{query.keyword}, '%')
                     OR u.student_no LIKE CONCAT('%', #{query.keyword}, '%'))
            </if>
        </where>
    </sql>

    <select id="selectPage" resultType="com.library.seat.entity.SeatAssessment">
        SELECT a.*, u.real_name AS userName, u.student_no AS studentNo,
               r.name AS roomName, s.seat_no AS seatNo
        <include refid="baseFrom"/>
        <include refid="whereSql"/>
        ORDER BY a.assess_month DESC, a.id DESC
        LIMIT #{query.offset}, #{query.limit}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(1)
        <include refid="baseFrom"/>
        <include refid="whereSql"/>
    </select>

</mapper>